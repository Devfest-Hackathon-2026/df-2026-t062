{
  "利用者名": {
    "op": "text@1",
    "ui": "text",
    "ref": {
      "key": "person.name"
    }
  },
  "作成年月日_y": {
    "op": "date@1",
    "ui": "text",
    "ref": {
      "key": "plan.createdDate"
    },
    "part": "y",
    "year": "short"
  },
  "作成年月日_m": {
    "op": "date@1",
    "ui": "text",
    "ref": {
      "key": "plan.createdDate"
    },
    "part": "m",
    "year": "short"
  },
  "作成年月日_d": {
    "op": "date@1",
    "ui": "text",
    "ref": {
      "key": "plan.createdDate"
    },
    "part": "d",
    "year": "short"
  },
  "週間枠": {
    "op": "text@1",
    "ui": "area",
    "ref": {
      "key": "plan.weekly"
    }
  },
  "日常生活活動": {
